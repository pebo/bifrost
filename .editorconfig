# editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{js,json,ts,tsx,jsx}]
indent_style = space
indent_size = 2
quote_type = single

[{go.mod,go.sum,*.go}]
indent_style = tab
indent_size = 4

[*.{md,markdown}]
trim_trailing_whitespace = false

[*.bat]
end_of_line = crlf

[*.yml]
indent_style = space
indent_size = 2

[Makefile*]
indent_style = tab
